# Copy this file to .env and fill in your values

# MongoDB (used by docker-compose)
MONGO_URI=mongodb://acme:acme_secret@localhost:27017/acme_dwh?authSource=admin
MONGO_DB_NAME=acme_dwh

# Nasdaq Data Link API key
# Get a free key at https://data.nasdaq.com/sign-up
# Leave as "demo" to use synthetic data (recommended for dev/demo)
NASDAQ_API_KEY=demo

# Anthropic API key — required for UC4 LLM assistant
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Optional
LOG_LEVEL=INFO
DEBUG=false
